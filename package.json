{
  "name": "baynavigator",
  "type": "module",
  "version": "2.0.0",
  "description": "Bay Area community resources - Free and low-cost programs",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/generate/relocate-api-to-data.cjs && node scripts/generate/stamp-sw-version.cjs",
    "preview": "astro preview",
    "generate-api": "node scripts/generate/generate-api.cjs && node scripts/generate/generate-geojson.cjs && node scripts/generate/generate-refinement-json.cjs && node scripts/generate/generate-search-index.cjs && node scripts/generate/generate-knowledge-pack.cjs",
    "generate:refinement": "node scripts/generate/generate-refinement-json.cjs",
    "generate:search": "node scripts/generate/generate-search-index.cjs",
    "generate:pack": "node scripts/generate/generate-knowledge-pack.cjs",
    "setup": "node scripts/util/setup.cjs",
    "sync:meilisearch": "node scripts/sync/sync-meilisearch.cjs",
    "verify:gate": "node scripts/validate/verify-gate.cjs",
    "test": "npx playwright test",
    "test:unit": "node --test tests/unit/*.test.cjs",
    "test:unit:coverage": "c8 --reporter=text --reporter=lcov --check-coverage --lines 80 --functions 80 --branches 70 node --test tests/unit/*.test.cjs",
    "test:a11y": "npx playwright test --project=accessibility --project=accessibility-mobile",
    "test:all": "npm run test:unit && npm run test",
    "validate:data": "node scripts/validate/validate-data.cjs",
    "validate:freshness": "node scripts/check/check-data-freshness.cjs",
    "validate:links": "node scripts/validate/validate-links.cjs --report",
    "generate:simple": "node scripts/generate/generate-simple-language-descriptions.cjs",
    "categorize": "node scripts/util/categorize-program.cjs",
    "diagnose:carl": "node scripts/util/diagnose-carl.cjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "bay-area",
    "community",
    "resources",
    "assistance"
  ],
  "author": "Bay Tides",
  "license": "MIT",
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.1",
    "astro-compress": "^2.4.3",
    "fuse.js": "^7.5.0",
    "js-yaml": "^4.3.1",
    "motion": "^13.2.0",
    "playwright": "^1.61.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.2"
  },
  "overrides": {
    "devalue": "^5.6.2",
    "h3": "^1.15.5",
    "minimatch": ">=10.2.1",
    "svgo": "^4.0.2",
    "nanoid": "^3.3.18",
    "deepmerge-ts": "^8.0.0",
    "sharp": "^0.35.0",
    "esbuild": "^0.28.1",
    "@babel/core": "^7.29.6",
    "brace-expansion": "^5.0.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.59.2",
    "adm-zip": "^0.6.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "c8": "^11.0.0",
    "eslint": "^10.5.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "string-similarity": "^4.0.4",
    "yaml": "^2.9.0"
  }
}
